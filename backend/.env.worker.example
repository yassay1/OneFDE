# Copy to .env.worker ONLY on the trusted dedicated Linux Worker. Never mount this file.
ONEFDE_WORKER_DATABASE_URL=postgresql+psycopg://worker:REPLACE@CONTROL_DB/onefde_dev
ONEFDE_WORKER_ROOT=/srv/onefde-worker
ONEFDE_WORKER_ISOLATED_HOST_CONFIRMED=false
ONEFDE_WORKER_NETWORK=onefde-engineering
# Set only after provider quota + outbound endpoint restrictions are configured.
# ONEFDE_WORKER_MAX_COST_USD=0.5
ONEFDE_WORKER_MAX_SECONDS=900
ONEFDE_WORKER_MAX_REQUESTS=20
ONEFDE_WORKER_CPUS=1
ONEFDE_WORKER_MEMORY=2g
ONEFDE_WORKER_PIDS_LIMIT=256
ONEFDE_WORKER_LEASE_SECONDS=120
ONEFDE_WORKER_HEARTBEAT_SECONDS=5
# Supply a scoped model key through the process environment/secret manager;
# ONEFDE_MODEL_ENGINEERING is the name referenced in model-profile.example.json.
