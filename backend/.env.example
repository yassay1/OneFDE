# Copy to .env; choose a local database password and replace it in all three URLs.
POSTGRES_PASSWORD=replace-with-local-database-password
ONEFDE_DATABASE_URL=postgresql+psycopg://onefde:replace-with-local-database-password@127.0.0.1:55432/onefde_dev
ONEFDE_TEST_DATABASE_URL=postgresql+psycopg://onefde:replace-with-local-database-password@127.0.0.1:55432/onefde_test
ONEFDE_OWNER_USERNAME=founder
# Run: uv run --locked python -m app.cli hash-password
# Paste Argon2id hash INSIDE single quotes: Compose must not interpolate its $ signs.
ONEFDE_OWNER_PASSWORD_HASH='REPLACE_WITH_ARGON2ID_HASH'
# Explicit local HTTP configuration. Production defaults require HTTPS + secure cookie.
ONEFDE_ENVIRONMENT=development
ONEFDE_TRUSTED_ORIGIN=http://localhost:8000
ONEFDE_COOKIE_SECURE=false
ONEFDE_SESSION_HOURS=8
ONEFDE_LOGIN_LIMIT=10
